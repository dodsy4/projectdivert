# Base URL of the Project Divert API. Leave blank to use the same origin the
# dashboard is served from, which is what the production build expects.
# In development, vite proxies /api to VITE_API_PROXY instead.
VITE_API_BASE_URL=

# Where `npm run dev` proxies /api to.
VITE_API_PROXY=http://127.0.0.1:5000

# Set to 1 to build the demo role switcher into the bundle: a control for
# jumping between the accounts `flask seed-demo` creates, so the same collection
# can be shown from the site manager's side and the driver's without signing out
# in the middle of a demonstration.
#
# Leave it unset for anything real. The switcher is compiled out entirely when
# it is unset, rather than hidden. It never contains a password -- you type the
# demo one once per session and it is held in memory only.
VITE_DEMO_MODE=
