# Flask
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-long-random-secret

# Database (managed Postgres)
DATABASE_URL=postgresql://username:password@host:5432/dbname

# Optional alternative to DATABASE_URL (safer when password contains special chars):
# PGHOST=host
# PGPORT=5432
# PGDATABASE=dbname
# PGUSER=username
# PGPASSWORD=replace-with-db-password
# PGSSLMODE=require

# Cookies / session security
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax
PREFERRED_URL_SCHEME=https

# Google Maps
GOOGLE_MAPS_API_KEY=replace-with-google-maps-key

# Email provider (for request notifications)
MAIL_PROVIDER=sendgrid
MAIL_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_API_KEY=replace-with-sendgrid-key
REQUEST_NOTIFICATION_EMAIL=materials@yourcompany.com
WASTE_REMOVAL_NOTIFICATION_EMAIL=collections@yourcompany.com

# Optional app domain
APP_BASE_URL=https://yourdomain.com

# JWT API auth
JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret
JWT_EXP_HOURS=24
JWT_REFRESH_EXP_DAYS=30
EMAIL_VERIFICATION_TOKEN_EXP_HOURS=24
PASSWORD_RESET_TOKEN_EXP_MINUTES=30
AUTH_REQUIRE_EMAIL_VERIFICATION=0
# For local testing only. Never enable in production.
AUTH_RETURN_TOKENS_IN_RESPONSE=0
AUTH_RATE_LIMIT_ENABLED=1
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_LOGIN_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_SIGNUP_MAX_ATTEMPTS=8
AUTH_RATE_LIMIT_REFRESH_MAX_ATTEMPTS=30
AUTH_RATE_LIMIT_ADMIN_MAX_ATTEMPTS=120
AUTH_RATE_LIMIT_VERIFY_REQUEST_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_VERIFY_CONFIRM_MAX_ATTEMPTS=20
AUTH_RATE_LIMIT_PASSWORD_RESET_REQUEST_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_PASSWORD_RESET_CONFIRM_MAX_ATTEMPTS=20
# Optional: enable persistent auth rate limits across app restarts/instances
# AUTH_RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
# AUTH_RATE_LIMIT_REDIS_PREFIX=projectdivert:auth-rate-limit
AUTH_RATE_LIMIT_ADMIN_ENABLED=1
AUTH_LOGIN_LOCKOUT_ENABLED=1
AUTH_LOGIN_LOCKOUT_WINDOW_SECONDS=900
AUTH_LOGIN_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_DURATION_SECONDS=900
AUTH_LOGIN_LOCKOUT_ESCALATION_ENABLED=1
AUTH_LOGIN_LOCKOUT_ESCALATION_FACTOR=2
AUTH_LOGIN_LOCKOUT_ESCALATION_RESET_SECONDS=86400
AUTH_LOGIN_LOCKOUT_MAX_DURATION_SECONDS=86400
AUTH_VERIFY_REQUEST_COOLDOWN_SECONDS=60
AUTH_PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
AUTH_MAX_ACTIVE_REFRESH_TOKENS=10
AUTH_BLOCKLIST_ENABLED=1
AUTH_BLOCKLIST_DEFAULT_DURATION_SECONDS=86400
AUTH_TOKEN_CLEANUP_RETENTION_DAYS=30
AUTH_SUSPICIOUS_ACTIVITY_REVOKE_SESSIONS=1
AUTH_SUSPICIOUS_ACTIVITY_REVOKE_MIN_LOCKOUT_LEVEL=1

# Dispatching
DISPATCH_OFFER_FANOUT=10
WASTE_REQUEST_STREAM_HEARTBEAT_SECONDS=20
DISPATCH_PENDING_MATCH_SLA_MINUTES=30
DISPATCH_UNASSIGNED_MATCH_SLA_MINUTES=20
DISPATCH_LOCATION_STALE_MINUTES=20
DISPATCH_ESCALATION_ACK_SLA_CRITICAL_MINUTES=10
DISPATCH_ESCALATION_ACK_SLA_HIGH_MINUTES=20
DISPATCH_ESCALATION_ACK_SLA_MEDIUM_MINUTES=45
DISPATCH_ESCALATION_ACK_SLA_LOW_MINUTES=90
DISPATCH_ESCALATION_RESOLVE_SLA_CRITICAL_MINUTES=60
DISPATCH_ESCALATION_RESOLVE_SLA_HIGH_MINUTES=180
DISPATCH_ESCALATION_RESOLVE_SLA_MEDIUM_MINUTES=360
DISPATCH_ESCALATION_RESOLVE_SLA_LOW_MINUTES=720
DISPATCH_ESCALATION_COOLDOWN_MINUTES=30
# Optional webhook for critical/high SLA breach alerts (Slack-compatible JSON POST)
DISPATCH_ESCALATION_WEBHOOK_URL=
DISPATCH_ESCALATION_WEBHOOK_TIMEOUT_SECONDS=8

# Payments (Stripe)
PAYMENTS_ENABLED=0
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Optional override (normally leave default)
STRIPE_API_BASE_URL=https://api.stripe.com
# Platform fee in basis points (1500 = 15%)
PLATFORM_FEE_BPS=1500
PLATFORM_CURRENCY=gbp

# Mobile push notifications (Expo)
EXPO_PUSH_ENABLED=1
# Optional (for Expo Push Security)
EXPO_PUSH_ACCESS_TOKEN=
# Optional override
EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send
