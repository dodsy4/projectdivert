# Flask
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-long-random-secret

# Database (managed Postgres)
DATABASE_URL=postgresql://username:password@host:5432/dbname

# Optional alternative to DATABASE_URL (safer when password contains special chars):
# PGHOST=host
# PGPORT=5432
# PGDATABASE=dbname
# PGUSER=username
# PGPASSWORD=replace-with-db-password
# PGSSLMODE=require

# Cookies / session security
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax
PREFERRED_URL_SCHEME=https

# Google Maps
GOOGLE_MAPS_API_KEY=replace-with-google-maps-key

# Email provider (for request notifications)
MAIL_PROVIDER=sendgrid
MAIL_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_API_KEY=replace-with-sendgrid-key
REQUEST_NOTIFICATION_EMAIL=materials@yourcompany.com
WASTE_REMOVAL_NOTIFICATION_EMAIL=collections@yourcompany.com

# Optional app domain
APP_BASE_URL=https://yourdomain.com

# JWT API auth
JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret
JWT_EXP_HOURS=24
JWT_REFRESH_EXP_DAYS=30
EMAIL_VERIFICATION_TOKEN_EXP_HOURS=24
PASSWORD_RESET_TOKEN_EXP_MINUTES=30
AUTH_REQUIRE_EMAIL_VERIFICATION=0
# For local testing only. Never enable in production.
AUTH_RETURN_TOKENS_IN_RESPONSE=0
AUTH_RATE_LIMIT_ENABLED=1
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_LOGIN_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_SIGNUP_MAX_ATTEMPTS=8
AUTH_RATE_LIMIT_REFRESH_MAX_ATTEMPTS=30
AUTH_RATE_LIMIT_ADMIN_MAX_ATTEMPTS=120
AUTH_RATE_LIMIT_VERIFY_REQUEST_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_VERIFY_CONFIRM_MAX_ATTEMPTS=20
AUTH_RATE_LIMIT_PASSWORD_RESET_REQUEST_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_PASSWORD_RESET_CONFIRM_MAX_ATTEMPTS=20
# Optional: enable persistent auth rate limits across app restarts/instances
# AUTH_RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
# AUTH_RATE_LIMIT_REDIS_PREFIX=projectdivert:auth-rate-limit
AUTH_RATE_LIMIT_ADMIN_ENABLED=1
AUTH_LOGIN_LOCKOUT_ENABLED=1
AUTH_LOGIN_LOCKOUT_WINDOW_SECONDS=900
AUTH_LOGIN_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_DURATION_SECONDS=900
AUTH_LOGIN_LOCKOUT_ESCALATION_ENABLED=1
AUTH_LOGIN_LOCKOUT_ESCALATION_FACTOR=2
AUTH_LOGIN_LOCKOUT_ESCALATION_RESET_SECONDS=86400
AUTH_LOGIN_LOCKOUT_MAX_DURATION_SECONDS=86400
AUTH_VERIFY_REQUEST_COOLDOWN_SECONDS=60
AUTH_PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
AUTH_MAX_ACTIVE_REFRESH_TOKENS=10
AUTH_BLOCKLIST_ENABLED=1
AUTH_BLOCKLIST_DEFAULT_DURATION_SECONDS=86400
AUTH_TOKEN_CLEANUP_RETENTION_DAYS=30
AUTH_SUSPICIOUS_ACTIVITY_REVOKE_SESSIONS=1
AUTH_SUSPICIOUS_ACTIVITY_REVOKE_MIN_LOCKOUT_LEVEL=1

# Ops health monitoring
OPS_HEALTH_AUTH_WINDOW_MINUTES=60
OPS_HEALTH_DISPATCH_LIMIT=500
OPS_HEALTH_DISPATCH_BACKLOG_WARN=25
OPS_HEALTH_DISPATCH_BACKLOG_CRITICAL=60
OPS_HEALTH_INCIDENT_CRITICAL_BREACH_WARN=1
OPS_HEALTH_INCIDENT_TOTAL_BREACH_WARN=5
OPS_HEALTH_LOCKOUT_EVENTS_WARN=5
OPS_HEALTH_ADMIN_RATE_LIMIT_EVENTS_WARN=5
OPS_HEALTH_AUDIT_5XX_EVENTS_WARN=1
OPS_HEALTH_BILLING_FOLLOWUPS_WARN=3
OPS_HEALTH_BILLING_FOLLOWUPS_CRITICAL=10
OPS_HEALTH_DIGEST_INCLUDE_OK=0
OPS_HEALTH_DIGEST_WEBHOOK_URL=
OPS_HEALTH_DIGEST_WEBHOOK_TIMEOUT_SECONDS=8
OPS_HEALTH_DIGEST_EMAIL_TO=
OPS_HEALTH_DIGEST_FAIL_ON_CRITICAL=0

# Database backups
BACKUP_OUTPUT_DIR=$HOME/Backups/projectdivert
BACKUP_RETENTION_DAYS=14
BACKUP_LABEL=projectdivert-db

# Shared Redis. Set at least one of these in production: without a Redis URL
# the job queue runs every job inline instead of on the worker, and the
# waste-request event stream cannot reach a client connected to a different
# gunicorn worker than the one that published the event.
REDIS_URL=
RQ_REDIS_URL=
RQ_JOB_TIMEOUT=600

# Dispatching
DISPATCH_OFFER_FANOUT=10
WASTE_REQUEST_STREAM_HEARTBEAT_SECONDS=20
WASTE_REQUEST_STREAM_HISTORY_SIZE=200
# Event stream Redis. Defaults to REDIS_URL/RQ_REDIS_URL when left blank.
# WASTE_REQUEST_STREAM_REDIS_URL=redis://localhost:6379/0
# WASTE_REQUEST_STREAM_REDIS_PREFIX=projectdivert:waste-request-events
WASTE_REQUEST_STREAM_HISTORY_TTL_SECONDS=3600

# Gunicorn (see gunicorn.conf.py). Concurrent SSE streams are bounded by
# WEB_CONCURRENCY * GUNICORN_THREADS, so size threads for the number of clients
# expected to be watching a job at once.
WEB_CONCURRENCY=2
GUNICORN_THREADS=8
# Run `flask db upgrade` (and seed materials) in the gunicorn master process
# before any worker forks. For hosts with no pre-deploy hook and no shell --
# Render's free tier, for instance -- where there is otherwise nowhere to
# migrate from. Leave it off anywhere that can migrate before a release goes
# live, and note it assumes a single instance.
MIGRATE_ON_BOOT=0
SEED_ON_BOOT=1

# Response security headers. The default CSP lives in projectdivert/hooks.py;
# set this to override it, or to an empty string to send no CSP at all.
# CONTENT_SECURITY_POLICY=
# Off unless set. A browser that sees this pins the domain to HTTPS for the
# duration, so enable it only once HTTPS is known good. 63072000 = 2 years.
HSTS_MAX_AGE_SECONDS=0
DISPATCH_PENDING_MATCH_SLA_MINUTES=30
DISPATCH_UNASSIGNED_MATCH_SLA_MINUTES=20
DISPATCH_LOCATION_STALE_MINUTES=20
DISPATCH_ESCALATION_ACK_SLA_CRITICAL_MINUTES=10
DISPATCH_ESCALATION_ACK_SLA_HIGH_MINUTES=20
DISPATCH_ESCALATION_ACK_SLA_MEDIUM_MINUTES=45
DISPATCH_ESCALATION_ACK_SLA_LOW_MINUTES=90
DISPATCH_ESCALATION_RESOLVE_SLA_CRITICAL_MINUTES=60
DISPATCH_ESCALATION_RESOLVE_SLA_HIGH_MINUTES=180
DISPATCH_ESCALATION_RESOLVE_SLA_MEDIUM_MINUTES=360
DISPATCH_ESCALATION_RESOLVE_SLA_LOW_MINUTES=720
DISPATCH_ESCALATION_COOLDOWN_MINUTES=30
# Optional webhook for critical/high SLA breach alerts (Slack-compatible JSON POST)
DISPATCH_ESCALATION_WEBHOOK_URL=
DISPATCH_ESCALATION_WEBHOOK_TIMEOUT_SECONDS=8
DISPATCH_INCIDENT_MAINTENANCE_LIMIT=500
DISPATCH_INCIDENT_MAINTENANCE_ENABLED=0
DISPATCH_INCIDENT_MAINTENANCE_DRY_RUN=0
DISPATCH_INCIDENT_AUTO_ASSIGN_ENABLED=0
DISPATCH_INCIDENT_AUTO_ASSIGN_ADMIN_EMAIL=
DISPATCH_INCIDENT_AUTO_RESOLVE_TEST_ENABLED=0
DISPATCH_INCIDENT_AUTO_RESOLVE_TEST_MINUTES=720

# Offline billing follow-up automation
OFFLINE_BILLING_FOLLOWUP_LIMIT=200
OFFLINE_BILLING_FOLLOWUP_AFTER_HOURS=72
OFFLINE_BILLING_FOLLOWUP_REPEAT_HOURS=72
OFFLINE_BILLING_FOLLOWUP_AUTOMATION_ENABLED=0
OFFLINE_BILLING_FOLLOWUP_DRY_RUN=0

# Payments (Stripe)
PAYMENTS_ENABLED=0
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Optional override (normally leave default)
STRIPE_API_BASE_URL=https://api.stripe.com
# Platform fee in basis points (1500 = 15%)
PLATFORM_FEE_BPS=1500
PLATFORM_CURRENCY=gbp

# Mobile push notifications (Expo)
EXPO_PUSH_ENABLED=1
# Optional (for Expo Push Security)
EXPO_PUSH_ACCESS_TOKEN=
# Optional override
EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send

# --- WhatsApp assistant -----------------------------------------------------
# Both flags default off; the webhook returns 404 and nothing is sent until set.
WHATSAPP_ENABLED=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_DEFAULT_MATCH_RADIUS_MILES=
CHATBOT_ENABLED=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
CHATBOT_HISTORY_TTL_SECONDS=
CHATBOT_REDIS_URL=
CHATBOT_REDIS_PREFIX=

# --- Diversion certificate --------------------------------------------------
CERTIFICATE_LANDFILL_DISTANCE_KM=

# `flask seed-demo` creates accounts with a known password, so it refuses to run
# outside debug/testing unless this says otherwise. Never set it on a deployment
# holding real data.
ALLOW_DEMO_SEED=0
