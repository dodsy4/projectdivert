# Use your reachable backend base URL (no trailing slash).
# For iOS simulator on same machine:
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:5000
# For Android emulator:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5000
# For physical device: use your Mac's LAN IP.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:5000

# Feature flag: enable payment UI/API actions when backend payments are enabled.
EXPO_PUBLIC_PAYMENTS_ENABLED=0

# Realtime sync tuning (milliseconds)
EXPO_PUBLIC_REALTIME_RECONNECT_DELAY_MS=2500
EXPO_PUBLIC_REALTIME_POLL_FALLBACK_INTERVAL_MS=10000
