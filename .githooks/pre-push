#!/bin/sh
set -eu

# Block pushes that introduce likely secrets in added lines.
SECRET_PATTERN='(AIza[0-9A-Za-z_-]{35}|AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36}|sk_(live|test)_[A-Za-z0-9]{16,}|SG\.[A-Za-z0-9_-]{16,}\.[A-Za-z0-9_-]{16,}|-----BEGIN (RSA|OPENSSH|EC|DSA) PRIVATE KEY-----|eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,})'

zero_hash='0000000000000000000000000000000000000000'
found=0

while read -r local_ref local_sha remote_ref remote_sha
do
  [ -z "${local_sha}" ] && continue
  [ "${local_sha}" = "${zero_hash}" ] && continue

  if [ "${remote_sha}" = "${zero_hash}" ]; then
    range="${local_sha}"
  else
    range="${remote_sha}..${local_sha}"
  fi

  added_lines="$(git log --no-color --format= --patch "${range}" | sed -n 's/^+//p' | grep -v '^+++' || true)"
  [ -z "${added_lines}" ] && continue

  if command -v rg >/dev/null 2>&1; then
    if printf '%s\n' "${added_lines}" | rg -n -e "${SECRET_PATTERN}" >/tmp/pre_push_secret_hits.$$; then
      found=1
      echo "Potential secret detected in commits being pushed:" >&2
      cat /tmp/pre_push_secret_hits.$$ >&2
    fi
  else
    if printf '%s\n' "${added_lines}" | grep -E -n "${SECRET_PATTERN}" >/tmp/pre_push_secret_hits.$$; then
      found=1
      echo "Potential secret detected in commits being pushed:" >&2
      cat /tmp/pre_push_secret_hits.$$ >&2
    fi
  fi
done

rm -f /tmp/pre_push_secret_hits.$$ >/dev/null 2>&1 || true

if [ "${found}" -ne 0 ]; then
  echo "Push blocked by secret scan hook. Remove or rotate exposed keys before pushing." >&2
  exit 1
fi
